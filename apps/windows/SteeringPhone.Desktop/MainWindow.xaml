<Window
    x:Class="SteeringPhone.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SteeringPhone PC Receiver &amp; Controller">

    <Grid Background="#0F1115" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="STEERINGPHONE" FontSize="20" FontWeight="Bold" Foreground="#E53935" />
                <TextBlock Text="PC RECEIVER" FontSize="20" FontWeight="Light" Foreground="#00E5FF" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#E53935" CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="UpdateBannerText" Text="New Update v1.0.1 Available!" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="UpdateButton" Content="Update Now" Click="OnUpdateClick" Background="#00E5FF" Foreground="Black" FontSize="11" FontWeight="Bold" CornerRadius="12" Padding="8,2" />
                    </StackPanel>
                </Border>

                <Border x:Name="StatusBadgeBorder" Background="#181B22" CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#00E676" />
                        <TextBlock x:Name="StatusText" Text="Listening for Phone..." Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Center Main Dashboard Area -->
        <Grid Grid.Row="1" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Rotating Steering Wheel Visualizer -->
            <Border Grid.Column="0" Background="#181B22" CornerRadius="16" Padding="24">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Interactive Steering Wheel Graphics -->
                    <Grid Grid.Row="0" Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="WheelTransform" Angle="0" />
                        </Grid.RenderTransform>

                        <!-- Outer Wheel Rim -->
                        <Ellipse Width="250" Height="250" Stroke="#00E5FF" StrokeThickness="18" />
                        
                        <!-- Top Center Red Notch -->
                        <Rectangle Width="12" Height="30" Fill="#E53935" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-2,0,0" RadiusX="4" RadiusY="4" />
                        
                        <!-- Steering Wheel Spokes -->
                        <Rectangle Width="216" Height="10" Fill="#2A2F3B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="108" Fill="#2A2F3B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />

                        <!-- Center Hub Badge -->
                        <Ellipse Width="64" Height="64" Fill="#E53935" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="SP" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Telemetry Degrees Readout -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24,0,0" Spacing="4">
                        <TextBlock x:Name="AngleText" Text="0.0°" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OutputText" Text="Steering Output: 0.00" FontSize="14" Foreground="#00E5FF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Pedals & Connection Telemetry Panel -->
            <StackPanel Grid.Column="1" Spacing="16">
                <!-- Throttle Gauge Card -->
                <Border Background="#181B22" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="THROTTLE" Foreground="#00E676" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="ThrottlePercentText" Text="0%" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="ThrottleBar" Value="0" Maximum="255" Height="10" Foreground="#00E676" Background="#2A2F3B" CornerRadius="5" />
                    </StackPanel>
                </Border>

                <!-- Brake Gauge Card -->
                <Border Background="#181B22" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="BRAKE" Foreground="#E53935" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="BrakePercentText" Text="0%" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="BrakeBar" Value="0" Maximum="255" Height="10" Foreground="#E53935" Background="#2A2F3B" CornerRadius="5" />
                    </StackPanel>
                </Border>

                <!-- Connection Metrics Card -->
                <Border Background="#181B22" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="TELEMETRY STATS" Foreground="Gray" FontWeight="Bold" FontSize="11" />
                        
                        <Grid>
                            <TextBlock Text="Packets Received:" Foreground="LightGray" FontSize="12" />
                            <TextBlock x:Name="PacketCountText" Text="0" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        
                        <Grid>
                            <TextBlock Text="Phone Battery:" Foreground="LightGray" FontSize="12" />
                            <TextBlock x:Name="BatteryText" Text="100%" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Ping Latency:" Foreground="LightGray" FontSize="12" />
                            <TextBlock x:Name="PingText" Text="&lt; 1 ms" Foreground="#00E676" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Controller Status Card -->
                <Border Background="#181B22" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VIRTUAL CONTROLLER" Foreground="Gray" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Xbox 360 Controller (XInput)" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="DriverStatusText" Text="Status: Checking Driver..." Foreground="#00E5FF" FontSize="11" />
                        <ProgressBar x:Name="DriverProgressBar" IsIndeterminate="True" Visibility="Collapsed" Height="4" Foreground="#00E5FF" />
                        <Button x:Name="DriverInstallBtn" Content="Install ViGEmBus Driver" Click="OnInstallDriverClick" Visibility="Collapsed" Background="#E53935" Foreground="White" FontSize="11" FontWeight="Bold" CornerRadius="8" HorizontalAlignment="Left" Padding="8,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer Bar -->
        <TextBlock Grid.Row="2" Text="SteeringPhone v1.0.0 — Open-Source Sim Racing Controller Solution" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</Window>
