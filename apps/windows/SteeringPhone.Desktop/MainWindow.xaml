<Window
    x:Class="SteeringPhone.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SteeringPhone Desktop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="SteeringPhone Desktop Controller" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Clean Architecture &amp; ViGEm Receiver Ready" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
